# Copy this file to missioncookies.env, then edit values for your droplet.

# SSH target for the missioncookies droplet.
MISSIONCOOKIES_SSH=root@YOUR_DROPLET_IP

# Optional SSH/SCP options. Uncomment if your droplet uses a custom key or port.
# SSH uses lowercase -p; SCP uses uppercase -P.
# MISSIONCOOKIES_SSH_OPTS="-i ~/.ssh/do_key -p 55976"
# MISSIONCOOKIES_SCP_OPTS="-i ~/.ssh/do_key -P 55976"

# Public website directory that Nginx serves for http://missioncookies.cv/.
# Put ai-exam-test.html, ai-exam-window.html, css, and js here.
MISSIONCOOKIES_WEB_DIR=/var/www/missioncookies

# Node app directory that contains server.js on the droplet.
MISSIONCOOKIES_APP_DIR=/var/www/missioncookies

# Command that restarts your Node backend on the droplet.
# Examples:
#   pm2 restart missioncookies
#   pm2 restart server
#   systemctl restart missioncookies
MISSIONCOOKIES_RESTART_CMD=pm2 restart missioncookies

# Test page URL after deployment.
MISSIONCOOKIES_TEST_URL=http://missioncookies.cv/ai-ilearning-view.html?id=251494

# Browser automation options.
MISSIONCOOKIES_HEADLESS=false
MISSIONCOOKIES_TIMEOUT=60
